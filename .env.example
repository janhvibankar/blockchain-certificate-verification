# ============================================================
# ENVIRONMENT VARIABLES - TEMPLATE
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to git.
# ============================================================

# For deploying to a public testnet (Sepolia, etc.) - NOT needed for local development
# PRIVATE_KEY=your_wallet_private_key_here

# For Alchemy or Infura RPC URL - NOT needed for local development
# ALCHEMY_API_KEY=your_alchemy_api_key_here

# For Etherscan contract verification - NOT needed for local development
# ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================================
# For this project (local development), you do NOT need any
# environment variables. The local Hardhat node provides
# test accounts automatically.
# ============================================================
